{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "framework": null,
  "outputDirectory": "build",
  "devCommand": "vite",
  "buildCommand": "vite build && node scripts/generate-sitemap.cjs",
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
